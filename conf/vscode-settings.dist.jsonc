{
  ////////////////////////
  /// Project specific ///
  ////////////////////////

  // CSS
  "stylelint.configFile": "./conf/stylelint.mjs",
  "stylelint.configBasedir": "./",

  // JS/TS
  "js/ts.tsdk.path": "./node_modules/typescript/lib",
  "eslint.options": {
    "overrideConfigFile": "./conf/eslint.mjs"
  },
  "eslint.workingDirectories": [
    {
      "directory": ".",
      "changeProcessCWD": true
    }
  ],

  // Markdown
  "markdownlint.configFile": "./conf/markdownlint.mjs",
  "markdownlint.configPointer": "/config",

  // PHP
  "php-cs-fixer.config": "./conf/php-cs-fixer.php;./conf/php-cs-fixer.dist.php",
  "php-cs-fixer.executablePath": "${workspaceFolder}/vendor/bin/php-cs-fixer",
  "php-cs-fixer.executablePathWindows": "${workspaceFolder}\\vendor\\bin\\php-cs-fixer.bat",
  "phpstan.binPath": "./vendor/bin/phpstan",
  "phpstan.configFile": "./conf/phpstan.php,./conf/phpstan.dist.php",

  ///////////////
  /// General ///
  ///////////////

  // Functional
  "files.trimFinalNewlines": true,
  "files.associations": {
    ".env{,.*}": "properties",
    "*.neon": "yaml",
    "LICENSE": "plaintext"
  },
  "emmet.includeLanguages": {
    "twig": "html"
  },
  "workbench.editorAssociations": {
    "*.svg": "default"
  },
  "todo-tree.general.tags": [
    "BUG",
    "HACK",
    "FIXME",
    "NOTICE",
    "TODO"
  ],

  // Visual
  "diffEditor.ignoreTrimWhitespace": false,
  "todo-tree.highlights.defaultHighlight": {
    "background": "#0000"
  },

  // Formatters
  "[css]": {
    "editor.defaultFormatter": "aeschli.vscode-css-formatter"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
  "[php]": {
    "editor.defaultFormatter": "junstyle.php-cs-fixer"
  },
  "[twig]": {
    "editor.defaultFormatter": "mblode.twig-language-2"
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },

  // Telemetry
  "gitlens.telemetry.enabled": false,
  "partialDiff.enableTelemetry": false,
  "redhat.telemetry.enabled": false,
  "telemetry.telemetryLevel": "off", // NOTICE: Can only be turned off in the default settings
  "intelephense.telemetry.enabled": false,

  // Copilot
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "properties": false,
    "markdown": false,
    "scminput": false
  },

  // Excludes
  "explorer.autoRevealExclude": {
    "**/.cache/**": true,
    "**/.changeset/**": true,
    "**/.git/**": true,
    "**/.hg/store/**": true,
    "**/.history/**": true,
    "**/.idea/**": true,
    "**/.next/**": true,
    "**/.nuxt/**": true,
    "**/.output/**": true,
    "**/.svelte-kit/**": true,
    "**/.temp/**": true,
    "**/.tmp/**": true,
    "**/.vercel/**": true,
    "**/.vite-inspect/**": true,
    "**/.vitepress/cache/**": true,
    "**/.vscode/**": true,
    "**/.yarn/**": true,
    "**/__snapshots__/**": true,
    "**/*.code-search": true,
    "**/*.min.*": true,
    "**/bower_components/**": true,
    "**/bun.lock": true,
    "**/composer.lock": true,
    "**/coverage/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/output/**": true,
    "**/package-lock.json": true,
    "**/pnpm-lock.yaml": true,
    "**/temp/**": true,
    "**/tests/**/fixtures/**": true,
    "**/tmp/**": true,
    "**/vendor/**": true,
    "**/vite.config.*.timestamp-*": true,
    "**/yarn.lock": true
  },
  "search.exclude": {
    "**/.cache/**": true,
    "**/.changeset/**": true,
    "**/.git/**": true,
    "**/.hg/store/**": true,
    "**/.history/**": true,
    "**/.idea/**": true,
    "**/.next/**": true,
    "**/.nuxt/**": true,
    "**/.output/**": true,
    "**/.svelte-kit/**": true,
    "**/.temp/**": true,
    "**/.tmp/**": true,
    "**/.vercel/**": true,
    "**/.vite-inspect/**": true,
    "**/.vitepress/cache/**": true,
    "**/.vscode/**": true,
    "**/.yarn/**": true,
    "**/__snapshots__/**": true,
    "**/*.code-search": true,
    "**/*.min.*": true,
    "**/bower_components/**": true,
    "**/bun.lock": true,
    "**/composer.lock": true,
    "**/coverage/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/output/**": true,
    "**/package-lock.json": true,
    "**/pnpm-lock.yaml": true,
    "**/temp/**": true,
    "**/tests/**/fixtures/**": true,
    "**/tmp/**": true,
    "**/vendor/**": true,
    "**/vite.config.*.timestamp-*": true,
    "**/yarn.lock": true
  },
  "files.watcherExclude": {
    "**/.cache/**": true,
    "**/.changeset/**": true,
    "**/.git/**": true,
    "**/.hg/store/**": true,
    "**/.history/**": true,
    "**/.idea/**": true,
    "**/.next/**": true,
    "**/.nuxt/**": true,
    "**/.output/**": true,
    "**/.svelte-kit/**": true,
    "**/.temp/**": true,
    "**/.tmp/**": true,
    "**/.vercel/**": true,
    "**/.vite-inspect/**": true,
    "**/.vitepress/cache/**": true,
    "**/.vscode/**": true,
    "**/.yarn/**": true,
    "**/__snapshots__/**": true,
    "**/*.code-search": true,
    "**/*.example": true,
    "**/*.min.*": true,
    "**/bower_components/**": true,
    "**/bun.lock": true,
    "**/composer.lock": true,
    "**/coverage/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/output/**": true,
    "**/package-lock.json": true,
    "**/pnpm-lock.yaml": true,
    "**/temp/**": true,
    "**/tests/**/fixtures/**": true,
    "**/tmp/**": true,
    "**/vendor/**": true,
    "**/vite.config.*.timestamp-*": true,
    "**/yarn.lock": true
  },
  "todo-tree.filtering.excludeGlobs": [
    "**/__snapshots__/**",
    "**/.cache/**",
    "**/.changeset/**",
    "**/.git/**",
    "**/.hg/store/**",
    "**/.history/**",
    "**/.idea/**",
    "**/.next/**",
    "**/.nuxt/**",
    "**/.output/**",
    "**/.svelte-kit/**",
    "**/.temp/**",
    "**/.tmp/**",
    "**/.vercel/**",
    "**/.vite-inspect/**",
    "**/.vitepress/cache/**",
    "**/.vscode/**",
    "**/.yarn/**",
    "**/*.code-search",
    "**/*.example",
    "**/*.min.*",
    "**/bower_components/**",
    "**/bun.lock",
    "**/composer.lock",
    "**/coverage/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/output/**",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/temp/**",
    "**/tests/**/fixtures/**",
    "**/tmp/**",
    "**/vendor/**",
    "**/vite.config.*.timestamp-*",
    "**/yarn.lock"
  ],

  /////////////////////////
  /// Language specific ///
  /////////////////////////

  // CSS
  "css.customData": [
    "./.vscode/css-custom-data.json"
  ],
  "tailwindCSS.emmetCompletions": true,
  "css.lint.unknownAtRules": "ignore",
  "css.validate": false,
  "scss.lint.unknownAtRules": "ignore",
  "scss.validate": false,
  "stylelint.validate": [
    "css",
    "html",
    "less",
    "scss",
    "svelte",
    "vue-html",
    "vue",
    "xml"
  ],

  // JS/TS
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.preferences.quoteStyle": "single",
  "svelte.enable-ts-plugin": true,
  "eslint.validate": [
    "css",
    "html",
    "javascript",
    "javascriptreact",
    "json",
    "json5",
    "jsonc",
    "markdown",
    "svelte",
    "toml",
    "typescript",
    "typescriptreact",
    "vue",
    "xml",
    "yaml"
  ],

  // PHP
  "phpstan.enableStatusBar": false,
  "phpstan.showTypeOnHover": true,
  // "phpstan.singleFileMode": true, // Turn single file mode on if you are encountering performance issues

  // JSON
  "json.schemas": [
    {
      "url": "https://getcomposer.org/schema.json",
      "fileMatch": [
        "composer.json",
        "*.composer.json"
      ]
    },
    {
      "url": "https://json.schemastore.org/package",
      "fileMatch": [
        "package.json",
        "*.package.json"
      ]
    },
    {
      "url": "https://json.schemastore.org/tsconfig",
      "fileMatch": [
        "tsconfig.json",
        "*.tsconfig.json"
      ]
    }
  ]
}
