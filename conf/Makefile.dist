STARTUP_TARGETS :=

APP_SERVICE := php-app bun-app

###> brnshkr/config ###
_BRNSHKR_CONFIG_PATHS := $(CURDIR)/node_modules/@brnshkr/config/conf/Makefile $(CURDIR)/$(or $(if $(wildcard $(CURDIR)/composer.json),$(shell awk 'match($$0, /"vendor-dir"[[:space:]]*:[[:space:]]*"[^"]*"/) { vendor_directory = substr($$0, RSTART, RLENGTH); sub(/^[^:]*:[[:space:]]*"/, "", vendor_directory); sub(/"$$/, "", vendor_directory); print vendor_directory; exit }' $(CURDIR)/composer.json)), vendor)/brnshkr/config/conf/Makefile

ifeq ($(wildcard $(_BRNSHKR_CONFIG_PATHS)),)
bootstrap:
	@$(if $(wildcard $(CURDIR)/package.json),$(_BRNSHKR_JS_RUN) $(_BRNSHKR_JS_INSTALL))
	@$(if $(wildcard $(CURDIR)/composer.json),$(_BRNSHKR_RUN) composer install --no-scripts --ignore-platform-reqs)
	@for path in $(_BRNSHKR_CONFIG_PATHS); do [ -r "$$path" ] && exit 0; done; echo 'brnshkr/config is not installed' >&2; exit 1
	@$(MAKE) --no-print-directory startup
else
include $(firstword $(wildcard $(_BRNSHKR_CONFIG_PATHS)))
endif
###< brnshkr/config ###

#-- app

#!! This project's targets

ping: #~~ answers pong
	$(DEBUG_PREFIX)$(call log,pong,$(COLOR_SUCCESS))

###> brnshkr/config ###
_BRNSHKR_COMPOSE_CANDIDATES := compose.yaml \
	compose.yml \
	docker-compose.yaml \
	docker-compose.yml

_BRNSHKR_COMPOSE_FILES = $(or \
	$(subst :, ,$(COMPOSE_FILE)), \
	$(firstword $(wildcard \
		$(addprefix $(CURDIR)/,$(_BRNSHKR_COMPOSE_CANDIDATES)) \
		$(addprefix $(CURDIR)/$(or $(CONFIG_DIR),conf)/,$(_BRNSHKR_COMPOSE_CANDIDATES)) \
	)) \
)

ifeq ($(wildcard $(_BRNSHKR_CONFIG_PATHS)),)
define _BRNSHKR_NEWLINE


endef

define _BRNSHKR_DOTENV_AWK
function fail(message) { sub(/\.$$/, "", message); gsub(/\$$/, "$$$$", message); printf "$$(error %s)\n", message; exit 1 }
function fail_format(message) { fail(message " in \"" display_path "\" at line " line_number ".") }
function quote_for_shell(text) { return SQ replace_all(text, SQ, SQ "\\" SQ SQ) SQ }
function replace_all(text, search, replacement,    out, position) {
	out = ""; while ((position = index(text, search))) { out = out substr(text, 1, position - 1) replacement; text = substr(text, position + length(search)) }; return out text
}
function character_at(position) { return position >= 1 ? substr(data, position, 1) : "" }
function skip_empty_lines(    start) {
	do {
		start = cursor; while (cursor < end && index(" \t\n\r\f\013", character_at(cursor))) { if (character_at(cursor) == "\n") line_number += 1; cursor += 1 }; if (character_at(cursor) == "#") while (cursor < end && character_at(cursor) != "\n") cursor += 1
	} while (cursor != start)
}
function lex_name(    rest, export_length, name_start, name, character) {
	rest = substr(data, cursor); export_length = match(rest, /^export[ \t]+/) ? RLENGTH : 0; if (export_length && match(substr(rest, export_length + 1), /^_*[A-Za-z][A-Za-z0-9_]*/)) name_start = export_length + 1
	else if (match(rest, /^_*[A-Za-z][A-Za-z0-9_]*/)) { name_start = 1; export_length = 0 }
	else fail_format("Invalid character in variable name")
	name = substr(rest, name_start, RLENGTH); cursor += name_start - 1 + RLENGTH; character = character_at(cursor); if (cursor == end || character == "\n" || character == "#") fail_format(export_length ? "Unable to unset an environment variable" : "Missing = in the environment variable declaration"); if (character == " " || character == "\t") fail_format("Whitespace characters are not supported after the variable name"); if (character != "=") fail_format("Missing = in the environment variable declaration"); cursor += 1; return name
}
function lex_nested_expression(    expression, character) {
	cursor += 1
	while (cursor < end && (character = character_at(cursor)) != "\n" && character != ")") {
		expression = expression character; if (character == "(") expression = expression lex_nested_expression() ")"; cursor += 1
	}
	if (cursor >= end || character_at(cursor) == "\n") fail_format("Missing closing parenthesis."); return expression
}
function protect_escaped_dollars(text,    out, position, backslash_count) {
	while ((position = index(text, "$$"))) {
		backslash_count = 0; while (backslash_count < position - 1 && substr(text, position - backslash_count - 1, 1) == "\\") backslash_count += 1; out = out (backslash_count % 2 ? substr(text, 1, position - 2) MARK : substr(text, 1, position)); text = substr(text, position + 1)
	}
	return out text
}
function lex_value(    rest, value, segment, length_to_quote, previous_character, character, protected_segment) {
	rest = substr(data, cursor); match(rest, /^[ \t]*(#[^\n]*)?/); if (substr(rest, RLENGTH + 1, 1) == "\n" || RLENGTH == length(rest)) { cursor += RLENGTH; skip_empty_lines(); return "" }; if (character_at(cursor) == " " || character_at(cursor) == "\t") fail_format("Whitespace are not supported before the value")
	do {
		character = character_at(cursor)
		if (character == SQ) {
			if (!(length_to_quote = index(substr(data, cursor + 1), SQ))) { cursor = end; fail_format("Missing quote to end the value") }; value = value replace_all(replace_all(substr(data, cursor + 1, length_to_quote - 1), "\\", "\\\\"), "$$", MARK); cursor += length_to_quote + 1
		} else if (character == "\"") {
			if (++cursor == end) fail_format("Missing quote to end the value"); segment = ""
			while (character_at(cursor) != "\"" || (character_at(cursor - 1) == "\\" && character_at(cursor - 2) != "\\")) {
				segment = segment character_at(cursor); if (++cursor == end) fail_format("Missing quote to end the value")
			}
			cursor += 1; value = value protect_escaped_dollars(replace_all(replace_all(replace_all(segment, "\\\"", "\""), "\\r", "\r"), "\\n", "\n"))
		} else {
			segment = ""; previous_character = character_at(cursor - 1)
			while (cursor < end && (character = character_at(cursor)) != "\n" && character != "\"" && character != SQ && !((previous_character == " " || previous_character == "\t") && character == "#")) {
				if (character == "\\" && (character_at(cursor + 1) == "\"" || character_at(cursor + 1) == SQ)) character = character_at(++cursor); segment = segment character; previous_character = character; if (character == "$$" && character_at(cursor + 1) == "(") { cursor += 1; segment = segment "(" lex_nested_expression() ")" }; cursor += 1
			}
			sub(/[ \t\n\r\013]+$$/, "", segment); protected_segment = protect_escaped_dollars(segment); if (protected_segment == segment && segment ~ /[ \t\n\r\f\013]/ && !index(segment, "$$")) fail_format("A value containing spaces must be surrounded by quotes"); value = value protected_segment; if (cursor < end && character_at(cursor) == "#") break
		}
	} while (cursor < end && character_at(cursor) != "\n")
	skip_empty_lines(); return value
}
function is_self_referencing(name, value,    position) {
	while ((position = index(value, "$$"))) {
		value = substr(value, position + 1); if (substr(value, 1, 1) == "{") value = substr(value, 2); if (substr(value, 1, length(name)) == name && substr(value, length(name) + 1, 1) !~ /[A-Za-z0-9_]/) return 1
	}
	return 0
}
function populate(name, value, is_overriding) {
	if (!is_overriding && !(name in is_loaded) && (name in value_by_name)) return; value_by_name[name] = value; is_loaded[name] = 1
}
function load(path,    line, status, name, value, file_name_count, file_names, value_in_file, name_index) {
	if ((status = (getline line < path)) < 0) return 0; data = status ? line : ""; while ((getline line < path) > 0) data = data "\n" line; close(path); display_path = index(path, _CURDIR "/") == 1 ? substr(path, length(_CURDIR) + 2) : path; line_number = 1; if (substr(data, 1, 3) == "\357\273\277") fail_format("Loading files starting with a byte-order-mark (BOM) is not supported."); data = replace_all(replace_all(data, "\r\n", "\n"), "\r", "\n"); cursor = 1; end = length(data) + 1; skip_empty_lines()
	while (cursor < end) {
		name = lex_name(); value = cursor < end ? lex_value() : ""; if (!(name in value_in_file)) file_names[++file_name_count] = name; value_in_file[name] = value
	}
	for (name_index = 1; name_index <= file_name_count; name_index += 1) {
		name = file_names[name_index]; value = value_in_file[name]; if (!(name in order_index)) order[order_index[name] = ++order_count] = name
		if (!(name in overridden_value)) {
			if (name in value_by_name) overridden_value[name] = value_by_name[name]
			else if (is_self_referencing(name, value) && (name in ENVIRON)) overridden_value[name] = ENVIRON[name]
		}
		if (((name in is_loaded) || !(name in value_by_name)) && !(name in raw_index)) raw_names[raw_index[name] = ++raw_count] = name
	}
	for (name_index = 1; name_index <= file_name_count; name_index += 1) populate(file_names[name_index], value_in_file[file_names[name_index]], 0); return 1
}
function run_command(command,    exports, name, shell_command, output, line, line_count) {
	for (name in is_loaded) exports = exports "export " name "=" quote_for_shell(replace_all(value_by_name[name], MARK, "$$")) "; "; shell_command = "sh -c " quote_for_shell(exports "{ echo " command "; } 2>/dev/null; printf " SQ "\\001" SQ) " 2>&1"; output = ""; while ((shell_command | getline line) > 0) output = output (line_count++ ? "\n" : "") line; close(shell_command); if (substr(output, length(output)) != MARK) fail_format("Issue expanding a command (" output ")"); output = substr(output, 1, length(output) - 1); sub(/[\n\r]+$$/, "", output); return output
}
function resolve_commands(value,    out, position, depth, scan, command) {
	while ((position = index(value, "$$("))) {
		depth = 0
		for (scan = position + 1; scan <= length(value); scan += 1) {
			if (substr(value, scan, 1) == "(") depth += 1
			else if (substr(value, scan, 1) == ")" && !--depth) break
		}
		if (scan > length(value) || scan == position + 2) { out = out substr(value, 1, position + 1); value = substr(value, position + 2); continue }; command = substr(value, position, scan - position + 1); out = out (position > 1 && substr(value, position - 1, 1) == "\\" ? substr(value, 1, position - 2) command : substr(value, 1, position - 1) run_command(command)); value = substr(value, scan + 1)
	}
	return out value
}
function resolve_variables(value,    out, position, backslash_count, rest, has_brace, name, default_value, has_closing_brace, matched_length, matched_text, prefix, resolved_value, is_external) {
	while ((position = index(value, "$$"))) {
		backslash_count = 0; while (backslash_count < position - 1 && substr(value, position - backslash_count - 1, 1) == "\\") backslash_count += 1; rest = substr(value, position + 1); if (substr(rest, 1, 1) == "(") { out = out substr(value, 1, position); value = rest; continue }; has_brace = substr(rest, 1, 1) == "{"; name = match(substr(rest, has_brace + 1), /^_*[A-Za-z][A-Za-z0-9_]*/) ? substr(rest, has_brace + 1, RLENGTH) : ""; default_value = match(substr(rest, has_brace + length(name) + 1), /^:[-=][^}]*/) ? substr(rest, has_brace + length(name) + 1, RLENGTH) : ""; matched_length = has_brace + length(name) + length(default_value); has_closing_brace = substr(rest, matched_length + 1, 1) == "}"; matched_length += has_closing_brace; prefix = substr(value, 1, position - 1 - backslash_count); matched_text = substr(value, position - backslash_count, backslash_count + 1 + matched_length); value = substr(rest, matched_length + 1); if (backslash_count % 2) { out = out prefix substr(matched_text, 2); continue }; if (name == "") { out = out prefix matched_text; continue }; if (has_brace && !has_closing_brace) fail_format("Unclosed braces on variable expansion"); is_external = 0; if ((name in is_loaded) && (name in assigned_value)) resolved_value = assigned_value[name]
		else if (name in value_by_name) { resolved_value = value_by_name[name]; is_external = 1 }
		else if (name in assigned_value) resolved_value = assigned_value[name]
		else { resolved_value = (name in ENVIRON) && !(name in hidden_names) ? ENVIRON[name] : ""; is_external = 1 }
		if (resolved_value != "" && !(name in is_loaded)) resolved_value = replace_all(is_external ? replace_all(resolved_value, "\\", "\\\\") : resolved_value, "$$", MARK)
		if (resolved_value == "" && default_value != "") {
			if (match(default_value, "[" SQ "\"{$$]")) fail_format("Unsupported character \"" substr(default_value, RSTART, 1) "\" found in the default value of variable \"$$" name "\"."); resolved_value = substr(default_value, 3); if (substr(default_value, 2, 1) == "=") assigned_value[name] = resolved_value
		}
		out = out prefix substr(matched_text, 1, backslash_count) resolved_value (!has_brace && has_closing_brace ? "}" : "")
	}
	return out value
}
function unescape(value) { return replace_all(replace_all(value, MARK, "$$"), "\\\\", "\\") }
function hide_own_value(name) {
	if (name in value_by_name) { hidden_value = value_by_name[name]; is_value_hidden = 1 } else is_value_hidden = 0; if (name in overridden_value) value_by_name[name] = replace_all(replace_all(overridden_value[name], "\\\\", "\\\\\\\\"), "$$", MARK)
	else { delete value_by_name[name]; hidden_names[name] = 1 }
}
function reveal_value(name) { delete hidden_names[name]; if (is_value_hidden) value_by_name[name] = hidden_value; else delete value_by_name[name] }
function hide_value(name) { if (name in value_by_name) { hidden_value = value_by_name[name]; is_value_hidden = 1 } else is_value_hidden = 0; delete value_by_name[name]; hidden_names[name] = 1 }
function resolve_environment_key(value,    resolved_value) {
	if (!index(value, "$$") && !index(value, MARK) && !index(value, "\\")) return value; split("", assigned_value); display_path = ""; line_number = 0; hide_value(_ENV_KEY); resolved_value = unescape(resolve_variables(resolve_commands(value))); reveal_value(_ENV_KEY); split("", assigned_value); return resolved_value
}
function resolve_loaded_values(    name_index, name, value, pass, changed_count, changed_names, changed_values, resolved_value, is_self_referencing_by_name, changed_list) {
	split("", assigned_value); display_path = ""; line_number = 0; for (name_index = 1; name_index <= raw_count; name_index += 1) if (is_self_referencing(raw_names[name_index], value_by_name[raw_names[name_index]] "")) is_self_referencing_by_name[raw_names[name_index]] = 1
	for (pass = 0; pass < 5; pass += 1) {
		changed_count = 0
		for (name_index = 1; name_index <= raw_count; name_index += 1) {
			name = raw_names[name_index]; if (!index(value = (name in value_by_name) ? value_by_name[name] : "", "$$")) continue; if (name in is_self_referencing_by_name) hide_own_value(name); resolved_value = resolve_variables(resolve_commands(value)); if (name in is_self_referencing_by_name) reveal_value(name); if (resolved_value != value) { changed_names[++changed_count] = name; changed_values[changed_count] = resolved_value }
		}
		if (!changed_count) break; for (name_index = 1; name_index <= changed_count; name_index += 1) populate(changed_names[name_index], changed_values[name_index], 1)
	}
	if (pass == 5 && changed_count) {
		for (name_index = 1; name_index <= changed_count; name_index += 1) changed_list = changed_list (name_index > 1 ? ", " : "") changed_names[name_index]; fail("Too many levels of variable indirection in env vars: " changed_list ".")
	}
	for (name_index = 1; name_index <= raw_count; name_index += 1) value_by_name[raw_names[name_index]] = unescape(value_by_name[raw_names[name_index]] "")
}
function is_test_environment(environment,    test_count, tests, test_index) {
	test_count = split(_TEST_ENVS, tests, /[ \t]+/); for (test_index = 1; test_index <= test_count; test_index += 1) if (tests[test_index] == environment) return 1; return 0
}
BEGIN {
	SQ = sprintf("%c", 39); MARK = sprintf("%c", 1); for (name in ENVIRON) if (name !~ /^HTTP_/) value_by_name[name] = ENVIRON[name]; if (_ENV_VALUE != "") value_by_name[_ENV_KEY] = _ENV_VALUE; if (!load(_BASE)) load(_BASE ".dist"); if (!(_ENV_KEY in value_by_name)) populate(_ENV_KEY, _DEFAULT_ENV, 0); environment = resolve_environment_key(value_by_name[_ENV_KEY]); if (!is_test_environment(environment) && load(_BASE ".local")) environment = resolve_environment_key(value_by_name[_ENV_KEY]); if (environment != "local") { load(_BASE "." environment); load(_BASE "." environment ".local") }; resolve_loaded_values(); if (!(_ENV_KEY in order_index)) order[order_index[_ENV_KEY] = ++order_count] = _ENV_KEY
	for (name_index = 1; name_index <= order_count; name_index += 1) {
		value = value_by_name[order[name_index]]; gsub(/\$$/, "$$$$", value); gsub(/#/, "\\#", value); gsub(/\n/, "$$(_BRNSHKR_NEWLINE)", value); sub(/^[ \t]/, "$$()&", value); sub(/\\$$/, "&$$()", value); printf "%s ?= %s@@brnshkr-dotenv-newline@@export %s@@brnshkr-dotenv-newline@@", order[name_index], value, order[name_index]
	}
}
endef

_BRNSHKR_DOTENV_BASE    := $(if $(filter 0 false off no,$(DOTENV)),,$(CURDIR)/$(or $(filter-out 1 true on yes,$(DOTENV)),.env))
_BRNSHKR_DOTENV_ENV_KEY := $(or $(DOTENV_ENV_KEY),APP_ENV)

$(eval $(subst @@brnshkr-dotenv-newline@@,$(_BRNSHKR_NEWLINE),$(if $(and $(_BRNSHKR_DOTENV_BASE),$(wildcard \
	$(_BRNSHKR_DOTENV_BASE) $(_BRNSHKR_DOTENV_BASE).dist)),$(shell awk \
	-v _BASE='$(_BRNSHKR_DOTENV_BASE)' \
	-v _CURDIR='$(CURDIR)' \
	-v _ENV_KEY='$(_BRNSHKR_DOTENV_ENV_KEY)' \
	-v _ENV_VALUE='$($(_BRNSHKR_DOTENV_ENV_KEY))' \
	-v _DEFAULT_ENV='$(or $(DOTENV_DEFAULT_ENV),dev)' \
	-v _TEST_ENVS='$(if $(filter undefined,$(origin DOTENV_TEST_ENVS)),test,$(DOTENV_TEST_ENVS))' \
	'$(_BRNSHKR_DOTENV_AWK)'))))
endif

_BRNSHKR_COMPOSE = HOST_UID="$$(id -u)" HOST_GID="$$(id -g)" HOST_APP_DIR='$(CURDIR)' \
	FORGE_NAMESPACE='$(or $(FORGE_NAMESPACE),docker.io/brnshkr)' docker compose \
	$(addprefix -f ,$(_BRNSHKR_COMPOSE_FILES))

_BRNSHKR_SERVICES    = $(eval _BRNSHKR_SERVICES := $$(shell $(_BRNSHKR_COMPOSE) config --services 2>/dev/null))$(_BRNSHKR_SERVICES)
_BRNSHKR_APP_SERVICE = $(if $(filter undefined,$(origin APP_SERVICE)),php-app bun-app,$(APP_SERVICE))
_BRNSHKR_JS_SERVICE  = $(if $(filter undefined,$(origin JS_SERVICE)),$(_BRNSHKR_APP_SERVICE),$(JS_SERVICE))
_BRNSHKR_CLI_SERVICE = $(if $(filter undefined,$(origin CLI_SERVICE)),cli,$(CLI_SERVICE))
_BRNSHKR_FROZEN      = $(if $(filter-out 0 false,$(CI)), --frozen-lockfile)

_BRNSHKR_RUN = $(and $(_BRNSHKR_APP_SERVICE),$(_BRNSHKR_COMPOSE_FILES),$(_BRNSHKR_COMPOSE) run --rm \
	$(firstword $(foreach SERVICE,$(_BRNSHKR_APP_SERVICE),$(filter $(SERVICE),$(_BRNSHKR_SERVICES))) $(_BRNSHKR_CLI_SERVICE)))

_BRNSHKR_JS_RUN = $(and $(_BRNSHKR_JS_SERVICE),$(_BRNSHKR_COMPOSE_FILES),$(_BRNSHKR_COMPOSE) run --rm \
	$(firstword $(foreach SERVICE,$(_BRNSHKR_JS_SERVICE),$(filter $(SERVICE),$(_BRNSHKR_SERVICES))) $(_BRNSHKR_CLI_SERVICE)))

_BRNSHKR_JS_INSTALL = $(or \
	$(if $(wildcard $(CURDIR)/bun.lock $(CURDIR)/bun.lockb),bun install$(_BRNSHKR_FROZEN)), \
	$(if $(wildcard $(CURDIR)/yarn.lock),yarn install), \
	$(if $(wildcard $(CURDIR)/pnpm-lock.yaml),pnpm install), \
	$(if $(wildcard $(CURDIR)/package-lock.json),npm install), \
	bun install \
)
###< brnshkr/config ###
