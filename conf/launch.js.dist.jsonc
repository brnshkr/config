{
  "configurations": [
    // Bun
    {
      "name": "Bun: attach",
      "type": "bun",
      "request": "attach",
      "url": "ws://localhost:6499/"
    },
    {
      "name": "Bun: launch current file",
      "type": "bun",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${file}",
      "runtimeArgs": ["--bun"],
      "stopOnEntry": false
    }
  ]
}
