<?xml version="1.0" encoding="UTF-8"?>
<phpunit
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="../vendor/phpunit/phpunit/phpunit.xsd"
  bootstrap="../vendor/autoload.php"
  cacheDirectory="../.cache/phpunit.cache"
  colors="true"
  displayDetailsOnAllIssues="true"
  executionOrder="random"
  beStrictAboutChangesToGlobalState="true"
  beStrictAboutCoverageMetadata="true"
  beStrictAboutOutputDuringTests="true"
  requireCoverageMetadata="true"
  failOnDeprecation="true"
  failOnEmptyTestSuite="true"
  failOnIncomplete="true"
  failOnNotice="true"
  failOnPhpunitDeprecation="true"
  failOnPhpunitNotice="true"
  failOnRisky="true"
  failOnSkipped="true"
  failOnWarning="true"
>
  <php>
    <ini name="display_errors" value="1"/>
    <ini name="error_reporting" value="-1"/>
  </php>

  <testsuites>
    <testsuite name="Brnshkr\Config">
      <directory>../tests/php</directory>
    </testsuite>

    <testsuite name="Brnshkr\Config shipped">
      <directory>../src/php/Testing</directory>
    </testsuite>
  </testsuites>

  <source
    restrictNotices="true"
    restrictWarnings="true"
    ignoreSuppressionOfDeprecations="true"
    ignoreSuppressionOfErrors="true"
    ignoreSuppressionOfNotices="true"
    ignoreSuppressionOfPhpDeprecations="true"
    ignoreSuppressionOfPhpNotices="true"
    ignoreSuppressionOfPhpWarnings="true"
    ignoreSuppressionOfWarnings="true"
  >
    <include>
      <directory suffix=".php">../src/php</directory>
    </include>
  </source>
</phpunit>
