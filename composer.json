{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "brnshkr/config",
  "version": "0.0.1-beta.4",
  "description": "Centralized collection of configuration and tooling used across all @brnshkr projects",
  "license": "MIT",
  "authors": [
    {
      "name": "Patrick Rupp"
    }
  ],
  "homepage": "https://github.com/brnshkr/config",
  "support": {
    "issues": "https://github.com/brnshkr/config/issues",
    "source": "https://github.com/brnshkr/config"
  },
  "type": "composer-plugin",
  "scripts": {
    "post-install-cmd": "make discover",
    "post-update-cmd": "make discover"
  },
  "require": {
    "php": ">=8.5",
    "ext-json": "*",
    "ext-mbstring": "*",
    "composer-plugin-api": "^2.0.0"
  },
  "require-dev": {
    "ext-ctype": "*",
    "ext-date": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-filter": "*",
    "ext-hash": "*",
    "ext-iconv": "*",
    "ext-libxml": "*",
    "ext-openssl": "*",
    "ext-pcre": "*",
    "ext-phar": "*",
    "ext-reflection": "*",
    "ext-simplexml": "*",
    "ext-tokenizer": "*",
    "ext-xmlwriter": "*",
    "composer/composer": "2.10.3",
    "dave-liddament/phpstan-rule-test-helper": "0.6.0",
    "friendsofphp/php-cs-fixer": "3.95.25",
    "helgesverre/toon": "3.2.1",
    "kubawerlos/php-cs-fixer-custom-fixers": "3.37.3",
    "matesofmate/composer-extension": "0.6.0",
    "matesofmate/phpstan-extension": "0.6.0",
    "matesofmate/phpunit-extension": "0.6.0",
    "matesofmate/rector-extension": "0.6.0",
    "pestphp/pest": "5.1.4",
    "phpat/phpat": "0.12.4",
    "phpstan/extension-installer": "1.4.3",
    "phpstan/phpstan": "2.2.13",
    "phpstan/phpstan-deprecation-rules": "2.0.5",
    "phpstan/phpstan-doctrine": "2.0.28",
    "phpstan/phpstan-phpunit": "2.0.18",
    "phpstan/phpstan-strict-rules": "2.0.12",
    "phpstan/phpstan-symfony": "2.0.20",
    "phpstan/phpstan-webmozart-assert": "2.0.0",
    "phpunit/phpunit": "13.3.2",
    "rector/rector": "2.6.6",
    "sebastian/diff": "9.0.1",
    "spatie/phpunit-snapshot-assertions": "5.4.0",
    "symfony/ai-mate": "0.12.0",
    "symfony/finder": "8.1.5",
    "symfony/process": "8.1.6",
    "symplify/phpstan-rules": "14.13.1",
    "ticketswap/phpstan-error-formatter": "1.3.0",
    "tomasvotruba/type-coverage": "2.3.6",
    "vincentlanglet/twig-cs-fixer": "4.1.1"
  },
  "conflict": {
    "friendsofphp/php-cs-fixer": "<3.95.25 || >=4",
    "kubawerlos/php-cs-fixer-custom-fixers": "<3.37.3 || >=4",
    "phpat/phpat": "<0.12.4 || >=0.13",
    "phpstan/extension-installer": "<1.4.3 || >=3",
    "phpstan/phpstan": "<2.2.13 || >=3",
    "phpstan/phpstan-deprecation-rules": "<2.0.5 || >=3",
    "phpstan/phpstan-doctrine": "<2.0.28 || >=3",
    "phpstan/phpstan-phpunit": "<2.0.18 || >=3",
    "phpstan/phpstan-strict-rules": "<2.0.12 || >=3",
    "phpstan/phpstan-symfony": "<2.0.20 || >=3",
    "phpstan/phpstan-webmozart-assert": "<2.0.0 || >=3",
    "rector/rector": "<2.6.6 || >=3",
    "symfony/finder": "<8.1.5 || >=9",
    "symplify/phpstan-rules": "<14.13.1 || >=15",
    "ticketswap/phpstan-error-formatter": "<1.3.0 || >=2",
    "tomasvotruba/type-coverage": "<2.3.6 || >=3",
    "vincentlanglet/twig-cs-fixer": "<4.1.1 || >=5"
  },
  "suggest": {
    "friendsofphp/php-cs-fixer": "Needed for automatically applying PHP coding standards",
    "kubawerlos/php-cs-fixer-custom-fixers": "Optional additional PHP CS Fixer rules",
    "phpat/phpat": "Optional architecture-related PHPStan rules",
    "phpstan/extension-installer": "Optional for autoloading of additional PHPStan configurations",
    "phpstan/phpstan": "Needed for static code analysis",
    "phpstan/phpstan-deprecation-rules": "Optional PHPStan rules for deprecations",
    "phpstan/phpstan-doctrine": "Optional additional PHPStan rules for Doctrine (It is recommended to configure parameters.doctrine.objectManagerLoader when using this extension)",
    "phpstan/phpstan-phpunit": "Optional additional PHPStan rules for PHPUnit",
    "phpstan/phpstan-strict-rules": "Optional strict PHPStan rules",
    "phpstan/phpstan-symfony": "Optional additional PHPStan rules for Symfony (It is recommended to configure parameters.symfony.consoleApplicationLoader when using this extension)",
    "phpstan/phpstan-webmozart-assert": "Optional additional PHPStan rules for Webmozart\\Assert",
    "rector/rector": "Needed for automatically applying upgrades and refactorings",
    "symfony/finder": "Needed when using PHP CS Fixer, Rector or PHPStan",
    "symplify/phpstan-rules": "Optional PHPStan rules by Symplify",
    "ticketswap/phpstan-error-formatter": "Optional PHPStan error output formatter",
    "tomasvotruba/type-coverage": "Optional type-related PHPStan rules",
    "vincentlanglet/twig-cs-fixer": "Needed for automatically applying Twig coding standards"
  },
  "autoload": {
    "psr-4": {
      "Brnshkr\\Config\\": "./src/php/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Brnshkr\\Config\\Tests\\": "./tests/php/",
      "Brnshkr\\Config\\Mate\\": "./conf/ai/mate/src/"
    },
    "classmap": [
      "./tests/php/Fixtures/"
    ],
    "exclude-from-classmap": [
      "/tests/php/Fixtures/Make/Configs/vendor/"
    ]
  },
  "extra": {
    "ai-mate": {
      "extension": false,
      "instructions": "conf/ai/mate/INSTRUCTIONS.md",
      "scan-dirs": [
        "conf/ai/mate/src"
      ],
      "includes": [
        "conf/ai/mate/config.php"
      ]
    },
    "class": "Brnshkr\\Config\\Composer\\Plugin"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": false,
      "phpstan/extension-installer": true,
      "symfony/ai-mate-composer-plugin": false
    }
  },
  "keywords": [
    "dev",
    "brnshkr",
    "config",
    "phpstan",
    "rector",
    "phpcsfixer",
    "php-cs-fixer",
    "static analysis",
    "twig",
    "twig-cs-fixer"
  ]
}
