# a comment line is skipped, and so is the blank line under it

this line is not an assignment and is skipped too
DOTENV_FIXTURE_PLAIN=one
DOTENV_FIXTURE_LATER=later
DOTENV_FIXTURE_EMPTY=
DOTENV_FIXTURE_SPACED  =  padded around the equals sign
DOTENV_FIXTURE_EQUALS=a=b=c
DOTENV_FIXTURE_TRAILING=trimmed   
DOTENV_FIXTURE_COMMENT=value # trailing comment
DOTENV_FIXTURE_DOUBLE="two  spaces"
DOTENV_FIXTURE_HASH_IN_QUOTES="not # a comment"
DOTENV_FIXTURE_SINGLE='no $interpolation and ${DOTENV_FIXTURE_PLAIN}'
DOTENV_FIXTURE_DOLLAR="a $ b"
DOTENV_FIXTURE_INTERPOLATED=${DOTENV_FIXTURE_PLAIN}-tail
DOTENV_FIXTURE_DOUBLE_INTERPOLATED="${DOTENV_FIXTURE_PLAIN} and ${DOTENV_FIXTURE_LATER}"
DOTENV_FIXTURE_ADJACENT=${DOTENV_FIXTURE_PLAIN}${DOTENV_FIXTURE_LATER}
DOTENV_FIXTURE_UNBRACED=$DOTENV_FIXTURE_PLAIN stays literal
DOTENV_FIXTURE_UNCLOSED=${DOTENV_FIXTURE_PLAIN
DOTENV_FIXTURE_AMBIENT_INTERPOLATED=${DOTENV_FIXTURE_AMBIENT}-tail
DOTENV_FIXTURE_FORWARD=${DOTENV_FIXTURE_UNSEEN}-tail
DOTENV_FIXTURE_UNSEEN=seen after the reference above
export DOTENV_FIXTURE_EXPORTED=yes
export DOTENV_FIXTURE_EXPORTED_QUOTED="quoted and exported"
DOTENV_FIXTURE_MULTILINE="line one
line two"
DOTENV_FIXTURE_SINGLE_MULTILINE='single line one
single line two'
DOTENV_FIXTURE_LAYER=base
